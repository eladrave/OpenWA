[Unit]
Description=OpenWA WhatsApp monitoring MCP container
Requires=docker.service
After=docker.service postgresql.service network-online.target
Wants=postgresql.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/services/openwa-monitor
ExecStartPre=/usr/bin/install -d -o root -g root -m 0700 /var/lib/openwa-monitor
ExecStartPre=/usr/bin/test -r /etc/openwa-monitor/runtime.env
ExecStartPre=/usr/bin/test -r /etc/openwa-monitor/deploy.env
ExecStartPre=/usr/bin/test -r /etc/openwa-monitor/postgres-ca.pem
ExecStartPre=/opt/services/openwa-monitor/check-secret-files.sh
ExecStart=/usr/bin/docker compose --project-name openwa-monitor --env-file /etc/openwa-monitor/deploy.env -f compose.yaml up -d
ExecStop=/usr/bin/docker compose --project-name openwa-monitor --env-file /etc/openwa-monitor/deploy.env -f compose.yaml stop
TimeoutStartSec=240
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
