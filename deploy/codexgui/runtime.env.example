NODE_ENV=production
PORT=2785
HOME=/tmp
XDG_CONFIG_HOME=/tmp/.config
XDG_CACHE_HOME=/tmp/.cache
SERVE_DASHBOARD=false
ENABLE_SWAGGER=false
QUEUE_ENABLED=false
REDIS_ENABLED=false
DATABASE_TYPE=postgres
DATABASE_HOST=<postgresql-certificate-hostname-mapped-to-host-gateway>
DATABASE_PORT=5432
DATABASE_USERNAME=<dedicated-openwa-role>
DATABASE_PASSWORD=<generate-once-and-store-only-in-this-root-owned-file>
DATABASE_NAME=<dedicated-openwa-database>
POSTGRES_SCHEMA=public
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
NODE_EXTRA_CA_CERTS=/run/secrets/postgres-ca.pem
MAIN_DATABASE_NAME=/app/data/main.sqlite
DATABASE_SYNCHRONIZE=false
MAIN_DATABASE_SYNCHRONIZE=false
AUTO_START_SESSIONS=true
MEDIA_DOWNLOAD_ENABLED=false
STORE_EPHEMERAL_MESSAGES=false
MCP_ENABLED=true
MCP_READONLY=true
MCP_TOOL_PROFILE=monitoring
MCP_MONITOR_CONFIG_WRITES=true
MCP_ENROLLMENT_WRITES=true
MCP_MONITOR_ALLOW_UNSCOPED_ADMIN=false
MCP_STABLE_URL_TOKEN=<generate-once-with-a-cryptographically-secure-source>
MCP_STABLE_BACKEND_API_KEY=<dedicated-operator-key-scoped-to-the-monitor-session>
MCP_MONITOR_CURSOR_SECRET=<generate-once-with-a-cryptographically-secure-source>
API_KEY_PEPPER=<generate-once-and-preserve-across-upgrades>
TRUSTED_PROXIES=<exact-live-edge-proxy-range>
CORS_ORIGINS=<exact-approved-origin-or-empty-when-dashboard-is-disabled>
LOG_LEVEL=info
